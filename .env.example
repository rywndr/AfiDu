DATABASE_URL='MY_DATABASE_URL'
ADMIN_EMAIL='MY_ADMIN_EMAIL'

# Student e-learning logins.
# Students are given an account automatically when their record is created.
STUDENT_LOGIN_EMAIL_DOMAIN='afidu.local'
STUDENT_DEFAULT_PASSWORD='1234'

# Cloudflare R2 media storage.
# Leave these unset to store uploads on the local filesystem (MEDIA_ROOT).
# All four are required to switch to R2.
R2_ACCOUNT_ID=''
R2_BUCKET_NAME=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''

# Lifetime of presigned URLs in seconds (only used when R2_PUBLIC_DOMAIN is empty).
R2_URL_EXPIRE_SECONDS='3600'
